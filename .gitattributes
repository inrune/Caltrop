# Normalize line endings in the repository; check out with the platform's default.
* text=auto

*.cs       text diff=csharp
*.csproj   text
*.props    text
*.targets  text
*.slnx     text
*.json     text
*.md       text
*.yml      text
*.sh       text eol=lf

*.png      binary
*.jpg      binary
*.ico      binary
*.snk      binary
